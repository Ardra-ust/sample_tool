# Copy to .env and fill in. Never commit .env. Secret values stay empty here.

# MySQL (database defaults to news_app)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Refresh status (defaults: refresh_status, row 1, 70 minutes stale-lock limit)
REFRESH_STATUS_TABLE=
REFRESH_STATUS_ROW_ID=
REFRESH_STALE_MINUTES=

# News sources
SEARCHAPI_IO_KEY=
TAVILY_API_KEY=

# Azure OpenAI (one resource for chat and embeddings; DQ-001, DQ-A3)
AZURE_OPENAI_CHAT_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2-chat
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_EMBED_ENDPOINT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_EMBED_API_KEY=
AZURE_OPENAI_EMBED_API_VERSION=

# Optional Azure WebJob trigger (used only when AZURE_WEBJOB_TRIGGER_URL is set; FR-039)
AZURE_WEBJOB_TRIGGER_URL=
AZURE_WEBJOB_USER=
AZURE_WEBJOB_PASS=
